if [[ "${1:-}" == "--list" ]]; then
    get_emojis
    exit 0
fi

selected=$(get_emojis | rofi -dmenu -i -p "󰞅 Emoji" -theme-str 'window { width: 560px; } listview { lines: 10; }' 2>/dev/null || true)

if [[ -n "$selected" ]]; then
    # Extract the emoji character (first space-delimited token)
    emoji=$(echo "$selected" | awk '{print $1}')
    if [[ -n "$emoji" ]]; then
        wl-copy "$emoji" >/dev/null 2>&1
        setsid -f notify-send -a "Emoji" -u low "Emoji Copied" "$emoji  copied to clipboard." >/dev/null 2>&1
    fi
fi
