#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: set-wallpaper <image>"
    exit 1
fi

wallpaper="$(realpath -e -- "$1")"

if [[ ! -f "$wallpaper" ]]; then
    echo "Not a file: $wallpaper"
    exit 1
fi

case "${wallpaper,,}" in
    *.jpg|*.jpeg|*.png|*.webp|*.jxl)
        ;;
    *)
        echo "Unsupported image format."
        exit 1
        ;;
esac

case "$wallpaper" in
    "$HOME"/Pictures/Wallpapers/*)
        ;;
    *)
        echo "Wallpaper must be inside:"
        echo "$HOME/Pictures/Wallpapers/"
        exit 1
        ;;
esac

state_dir="$HOME/.local/state/predator-shell"
config="$HOME/.config/hypr/hyprpaper.conf"

mkdir -p "$state_dir"

# Shared state used by Hyprlock and later Quickshell.
printf '%s\n' "$wallpaper" > "$state_dir/wallpaper"

# Persist wallpaper for the next Hyprpaper startup.
cat > "$config" <<EOF
splash = false
ipc = true

wallpaper {
    monitor =
    path = $wallpaper
    fit_mode = cover
}
EOF

# Apply immediately if Hyprpaper is already running.
if hyprctl hyprpaper listactive >/dev/null 2>&1; then
    while read -r monitor; do
        [[ -n "$monitor" ]] || continue

        hyprctl hyprpaper wallpaper \
            "$monitor, $wallpaper, cover"
    done < <(
        hyprctl monitors \
            | awk '/^Monitor / { print $2 }'
    )
else
    systemctl --user restart hyprpaper.service
fi
