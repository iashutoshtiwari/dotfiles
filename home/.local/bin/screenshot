#!/usr/bin/env bash
set -euo pipefail

screenshots_dir="$HOME/Pictures/Screenshots"
mkdir -p -- "$screenshots_dir"

file="$screenshots_dir/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png"
mode="${1:-area}"

case "$mode" in
    area)
        # Slurp selection with Catppuccin Mocha + Lavender styling
        geometry=$(slurp -b '#1e1e2e88' -c '#b4befeff' -s '#00000000' -w 2) || exit 0
        grim -g "$geometry" "$file"
        ;;
    screen)
        # Fullscreen capture
        grim "$file"
        ;;
    window)
        # Active window capture via hyprctl activewindow
        window_box=$(hyprctl activewindow -j 2>/dev/null | python3 -c '
import json, sys
try:
    w = json.load(sys.stdin)
    if "at" in w and "size" in w:
        print(f"{w[\"at\"][0]},{w[\"at\"][1]} {w[\"size\"][0]}x{w[\"size\"][1]}")
except Exception:
    pass
' 2>/dev/null || true)

        if [[ -n "$window_box" ]]; then
            grim -g "$window_box" "$file"
        else
            geometry=$(slurp -b '#1e1e2e88' -c '#b4befeff' -s '#00000000' -w 2) || exit 0
            grim -g "$geometry" "$file"
        fi
        ;;
    *)
        echo "Usage: screenshot [area|screen|window]" >&2
        exit 2
        ;;
esac

[[ -f "$file" ]] || exit 1

# Copy to clipboard immediately (redirect stdout/stderr so background wl-copy daemon detaches)
wl-copy -t image/png < "$file" >/dev/null 2>&1

# Rich notification in background completely detached via setsid
setsid -f bash -c '
    file="$1"
    dir="$2"
    action=$(notify-send \
        -a "Screenshot" \
        -i "$file" \
        -u low \
        "Screenshot Captured" \
        "Saved to ~/Pictures/Screenshots and copied to clipboard." \
        -A copy="Copy" \
        -A open="Open" \
        -A reveal="Reveal" 2>/dev/null || true)

    case "$action" in
        copy) wl-copy -t image/png < "$file" >/dev/null 2>&1 ;;
        open) xdg-open "$file" >/dev/null 2>&1 ;;
        reveal)
            if command -v dolphin >/dev/null 2>&1; then
                dolphin --select "$file" >/dev/null 2>&1
            else
                xdg-open "$dir" >/dev/null 2>&1
            fi
            ;;
    esac
' _ "$file" "$screenshots_dir" </dev/null >/dev/null 2>&1
